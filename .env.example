OPENAI_API_KEY=
# Optional: reasoning effort for both agents (none, minimal, low, medium, high, xhigh, max).
# Leave empty to use the SDK default.
REASONING_EFFORT=
# Live sandbox only (the API functions). The CLI needs none of these.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DEMO_PASSCODE=
IP_HASH_SALT=
# Test hooks, read only outside production (ignored when VERCEL_ENV or NODE_ENV is production).
# Lower one rate limit, for example in vercel dev:
LIMIT_PER_IP_PER_HOUR=
LIMIT_PER_SANDBOX_TOTAL=
LIMIT_SITE_PER_24_HOURS=
# Make approvals fail on purpose: before_decision or after_decision.
LIVE_TEST_FAIL_RESUME=
# Set to 1 to make every resume screening fail, to try the Retry button.
LIVE_TEST_FAIL_SCREENING=
